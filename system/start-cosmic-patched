#!/bin/sh
# Session launcher for "COSMIC (patched)". install-system-files.sh copies it to
# /usr/local/bin and fills in @ROOT@ (this checkout). Same as start-cosmic, but the
# bin/ folder of each patched component goes first in PATH, only if it was built
# for the installed package version. Anything stale or missing runs stock.

# Do start-cosmic's login-shell step ourselves, so the shell profile can't reorder PATH after us.
if [ -n "${SHELL:-}" ] && [ "${1:-}" != "--in-login-shell" ]; then
    exec "$SHELL" -l -c "$0 --in-login-shell"
fi

for dir in "@ROOT@"/*/; do
    built=$(cat "${dir}version" 2>/dev/null) || continue    # e.g. "cosmic-comp 1:1.10.0-1.1"
    [ "$(pacman -Q "${built%% *}" 2>/dev/null)" = "$built" ] && PATH="${dir}bin:$PATH"
done

export PATH COSMIC_PATCHED=1
exec /usr/bin/start-cosmic --in-login-shell
